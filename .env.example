# Where the FastAPI backend lives.
#
# Two variables for one URL, on purpose. Server Components, Route Handlers and
# Server Actions use API_BASE_URL and can therefore point at an internal
# hostname the browser cannot reach (a Docker service name, a private VPC
# address). NEXT_PUBLIC_API_BASE_URL is inlined into the client bundle and is
# only used to build the scan progress WebSocket URL, because a WebSocket
# cannot be proxied through a Server Component.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
